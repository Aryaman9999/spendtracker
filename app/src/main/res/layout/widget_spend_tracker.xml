<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background"
    android:clipToPadding="false">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="SpendTracker"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/widget_refresh_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:contentDescription="Refresh"
            android:src="@android:drawable/stat_notify_sync"
            android:scaleType="fitCenter"
            android:tint="#B3FFFFFF" />

    </RelativeLayout>

    <!-- Today's Spend -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_today_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹0"
        android:textColor="#FFFFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Month's Spend -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This month: "
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_month_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹0"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginBottom="8dp" />

    <!-- Recent Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recent"
        android:textColor="#B3FFFFFF"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:layout_marginBottom="4dp" />

    <!-- Transaction 1 -->
    <LinearLayout
        android:id="@+id/widget_txn1_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_txn1_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#DDFFFFFF"
            android:textSize="12sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_txn1_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFEF9A9A"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Transaction 2 -->
    <LinearLayout
        android:id="@+id/widget_txn2_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_txn2_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#DDFFFFFF"
            android:textSize="12sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_txn2_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFEF9A9A"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Transaction 3 -->
    <LinearLayout
        android:id="@+id/widget_txn3_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_txn3_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#DDFFFFFF"
            android:textSize="12sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_txn3_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFEF9A9A"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- No transactions message -->
    <TextView
        android:id="@+id/widget_no_txns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No transactions yet"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingTop="4dp"
        android:visibility="gone" />

</LinearLayout>
